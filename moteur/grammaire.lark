// Formules canoniques des amendements (guide de légistique de l'AN), lues par moteur/analyse.py.
//
// Deux points d'entrée :
//   en_ligne : l'instruction entière, citations comprises (« À l'alinéa 2, substituer au mot : « a », le mot : « b ». »)
//   bloc     : le chapeau seul, terminé par « : », quand le texte inséré est fait des alinéas qui suivent
//              (« Rédiger ainsi cet article : », « Après l'alinéa 3, insérer les six alinéas suivants : »)
// Les mots-clés ignorent la casse ; l'apostrophe peut être droite ou typographique.
// Une phrase qui admet deux analyses est rejetée par le code (parser Earley, ambiguity="explicit").
// Chaque alias (-> substitute…) est une méthode de _VersOperations ; les terminaux en _ sont retirés de l'arbre.

// ---- en ligne

en_ligne: (cible ","?)? action _FIN?

// « audit alinéa 3 » porte déjà sa préposition, « à la fin des alinéas 4 et 7 » aussi.
cible: _A "la"i "fin"i (_DE? designation)?   -> fin_de
     | "au"i "début"i (_DE? designation)?    -> debut_de
     | (_A | "au"i)? designation             -> dans

// _DP et _SEP : la ponctuation autour des citations varie (« le mot ; », « « a » ; le mot », « « a, » : insérer »).
// « rédiger ainsi la fin » sans désignation vise le nœud du préfixe (« À l'alinéa 3, après le mot…, rédiger ainsi la fin »).
action: "substituer"i (occurrence | _OBJET) _DP? CITATION _SEP? _OBJET _DP? CITATION    -> substitute
      | "remplacer"i (occurrence | _OBJET) _DP? CITATION _SEP? "par"i _OBJET _DP? CITATION -> substitute
      | "supprimer"i (occurrence | _OBJET) _DP? CITATION                               -> delete_mots
      | APRES (occurrence | _OBJET) _DP? CITATION _SEP? _INSERER _OBJET _DP? CITATION   -> insert_mots
      | APRES (occurrence | _OBJET) _DP? CITATION _SEP? _REDIGER "la"i "fin"i (_DE? designation)? _DP? CITATION -> rewrite_fin
      | APRES (occurrence | _OBJET) _DP? CITATION _SEP? "supprimer"i "la"i "fin"i (_DE? designation)? -> delete_fin
      | _INSERER (_OBJET | _phrases) _DP? CITATION                                     -> insert_bord
      | "compléter"i designation "par"i (_OBJET | _phrases) _DP? CITATION              -> complete
      | "supprimer"i designation                                                       -> delete_node
      | _REDIGER designation _DP? CITATION                                             -> rewrite
      | "procéder"i _A "la"i "même"i GENRE_RENVOI cible?                               -> renvoi

// « à la seconde occurrence du mot », « après la première occurrence du mot »
occurrence: _A? "la"i ORDINAL "occurrence"i _DE_OBJET

// « par la phrase suivante », « par les deux phrases suivantes » : le nombre n'est pas vérifié en ligne.
_phrases: _PHRASE | "les"i CARDINAL "phrases"i "suivantes"i

// ---- bloc

bloc: _REDIGER designation ":"                                          -> b_rewrite
    | "rétablir"i _SUBDIVISION? designation "dans"i "la"i "rédaction"i "suivante"i ":" -> b_rewrite
    | "substituer"i _A? designation ","? compte ":"                     -> b_rewrite_compte
    | APRES designation ","? _INSERER compte ":"                        -> b_insert_node
    | "au"i "début"i (("de"i | "du"i) designation)? ","? _INSERER compte ":"  -> b_insert_debut
    | "compléter"i designation "par"i (compte | _OBJET) ":"             -> b_complete

compte: _ALINEA_SUIVANT                                -> un_alinea
      | _UN_ALINEA_REDIGE                              -> un_alinea
      | "les"i CARDINAL "alinéas"i "suivants"i         -> n_alineas
      | "les"i "alinéas"i "suivants"i                  -> alineas_sans_nombre
      | _PHRASE                                        -> une_phrase
      | "les"i CARDINAL "phrases"i "suivantes"i        -> n_phrases

// ---- désignations

// « la même première phrase du même alinéa 4 », « la seconde phrase dudit alinéa », « la première phrase » seule
// (l'alinéa est alors celui de l'instruction précédente, ou le seul de l'article), « la même phrase ».
?designation: (_LA | _LA_MEME) ORDINAL "phrase"i (_DE? alinea)?  -> phrase_de
           | _LA_MEME "phrase"i (_DE? alinea)?                 -> meme_phrase
           | alinea
           | _ALINEAS NOMBRE "à"i NOMBRE                      -> alineas_de_a
           | _ALINEAS NOMBRE ("," NOMBRE)* "et"i NOMBRE       -> alineas_liste
           | "cet"i "alinéa"i                                 -> cet_alinea
           | "cet"i "article"i                                -> cet_article
           | "cet"i "amendement"i                             -> cet_article
           | _ARTICLE_L NUMERO_ARTICLE                        -> article_numero
           | "le"i "titre"i                                   -> titre

// « l'alinéa » sans numéro : celui du préfixe (« À l'alinéa 15, après le mot…, rédiger ainsi la fin de l'alinéa »).
?alinea: _ALINEA_L NOMBRE            -> alinea_numero
       | _ALINEA_L                   -> cet_alinea
       | "le"i ORDINAL "alinéa"i    -> alinea_ordinal
       | ORDINAL "alinéa"i          -> alinea_ordinal
       | _MEME "alinéa"i NOMBRE?    -> meme_alinea

APRES: /après|avant/i
GENRE_RENVOI: /substitution|suppression|insertion/i
_A: /[àa]\b/i
_FIN: /[.;,]/
_DP: /[:;]/
_SEP: /[,;:.]/
_DE: /(de|du)\b/i
_LA: /la\b|l['’]/i
_LA_MEME: /la\s+même|ladite/i
// « Rétablir le I de l'alinéa 3 », « les 4° et 5° de l'alinéa 17 » : la subdivision est l'alinéa lui-même.
_SUBDIVISION: /l[ea]s?\s+(\d+°|[IVX]+|[a-z])(\s+(bis|ter|[A-Z]))?(\s+et\s+(\d+°|[IVX]+|[a-z]))?\s+d[eu]\b/i
_ARTICLE_L: /l['’]\s*article/i
NUMERO_ARTICLE: /premier|1er|unique|\d+(\s+(bis|ter|quater|quinquies|sexies)\b)?(\s+[A-Z]\b)?/i
_INSERER: /insérer|ajouter/i
_REDIGER: /rédiger\s+ainsi/i
// Le mot, la référence, le montant… : un même verbe pour tout ce qu'un amendement cite.
_OBJET: /(aux\s+|au\s+|à\s+la\s+|à\s+l['’]\s*|les\s+|le\s+|la\s+|l['’]\s*)(mots?|références?|montants?|dates?|années?|nombres?|taux|pourcentages?|chiffres?|durées?|signes?|mentions?|délais?|sigles?|termes?|expressions?)(\s+et\s+(la|le|les)\s+\w+)?/i
_DE_OBJET: /(du\s+|de\s+la\s+|de\s+l['’]\s*|des\s+)(mots?|références?|montants?|dates?|années?|nombres?|taux|pourcentages?|chiffres?|durées?|signes?|mentions?|délais?|sigles?|termes?|expressions?)/i
_PHRASE: /la\s+phrase\s+suivante/i
_ALINEA_L: /l['’]\s*alinéa/i
_ALINEAS: /(les|aux|des)\s+alinéas/i
_ALINEA_SUIVANT: /l['’]\s*alinéa\s+suivant/i
_UN_ALINEA_REDIGE: /un\s+alinéa\s+ainsi\s+rédigé/i
_MEME: /((ce|le)\s+)?même|ledit|dudit|audit/i
NOMBRE: /\d+/
// « dernier » vaut -1 et « avant-dernier » -2 (comptés depuis la fin à l'étape 2).
ORDINAL: /(?:premier|première|deuxième|second|seconde|troisième|quatrième|cinquième|sixième|septième|huitième|neuvième|dixième|onzième|douzième|treizième|quatorzième|quinzième|seizième|dix-septième|dix-huitième|dix-neuvième|vingtième|dernier|dernière|avant-dernier|avant-dernière)\b/i
CARDINAL: /(?:deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze|quinze|seize|dix-sept|dix-huit|dix-neuf|vingt|\d+)\b/i
// Une citation, guillemets imbriqués compris sur un niveau.
CITATION: /«[^«»]*(«[^«»]*»[^«»]*)*»/

%ignore /[\s\u00a0\u202f]+/
